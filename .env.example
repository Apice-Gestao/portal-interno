# Valores de exemplo; npm run db:setup gera credenciais aleatórias em .env.
PORTAL_STORAGE=postgres
DATABASE_URL=postgresql://apice_runtime:replace_me@127.0.0.1:55432/apice_portal
MIGRATION_DATABASE_URL=postgresql://apice_owner:replace_me@127.0.0.1:55432/apice_portal
PORTAL_TIMEZONE=America/Sao_Paulo
# TEMPORÁRIO: testes locais com dados fictícios. Remover antes da implantação na VPS.
ENABLE_LOCAL_TEST_LOGIN=false
LOCAL_TEST_USERNAME=
LOCAL_TEST_ADMIN_PASSWORD=
LOCAL_TEST_OPERATOR_PASSWORD=
